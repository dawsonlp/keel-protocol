{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keel-protocol:direct-grant:1",
  "title": "Decoded Keel direct grant",
  "description": "Decoded parts of a compact JWS. See direct-grant.md for byte limits, canonical encoding, exact dates and comparisons, key verification and contextual authority checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protected", "claims"],
  "properties": {
    "protected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typ", "alg"],
      "properties": {
        "typ": {"const": "keel-direct-grant-v1+jws"},
        "alg": {"enum": ["EdDSA", "ES256"]}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iss", "id", "subject", "holder", "holder_jkt", "audience", "permission", "not_before", "expires_at"],
      "properties": {
        "iss": {"$ref": "#/$defs/principal"},
        "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"},
        "subject": {"$ref": "#/$defs/principal"},
        "holder": {"$ref": "#/$defs/actor"},
        "holder_jkt": {"type": "string", "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048](?![\\s\\S])"},
        "audience": {"$ref": "#/$defs/actor"},
        "permission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract", "parameters"],
          "properties": {
            "contract": {"type": "string", "pattern": "^[A-Za-z0-9._:/@+-]{1,128}(?![\\s\\S])"},
            "parameters": {"type": "object"}
          }
        },
        "not_before": {"$ref": "#/$defs/time"},
        "expires_at": {"$ref": "#/$defs/time"}
      }
    }
  },
  "$defs": {
    "principal": {"type": "string", "pattern": "^(party|actor):[A-Za-z0-9._@+-]{1,128}(?![\\s\\S])"},
    "actor": {"type": "string", "pattern": "^actor:[A-Za-z0-9._@+-]{1,128}(?![\\s\\S])"},
    "time": {
      "type": "string",
      "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z(?![\\s\\S])"
    }
  }
}
